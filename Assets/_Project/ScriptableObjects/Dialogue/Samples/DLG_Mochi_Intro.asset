  - id: s2
    speaker: {fileID: 11400000, guid: 2336e8beec8c63b449fee258b3d4c19a, type: 2}
    speakerNameOverride: 
    expression: happy
    text: I'm Mochi. I keep the ovens warm and the mice honest.
    nextNodeId: 
    jumps: []
    choices:
    - text: Nice to meet you, Mochi.
      nextNodeId: polite
      conditions: []
      actions:
      - type: 2
        key: 
        character: {fileID: 11400000, guid: 2336e8beec8c63b449fee258b3d4c19a, type: 2}
        value: 3
    - text: Cats can talk?
