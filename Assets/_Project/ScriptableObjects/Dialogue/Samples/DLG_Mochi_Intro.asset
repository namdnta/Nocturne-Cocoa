  - id: polite
    speaker: {fileID: 11400000, guid: 2336e8beec8c63b449fee258b3d4c19a, type: 2}
    speakerNameOverride: 
    expression: happy
    text: Polite. I approve. Now go make something sweet.
    nextNodeId: done
    jumps: []
    choices: []
    onEnter: []
