    speakerNameOverride: ???
    expression: neutral
    text: Oh! The lanterns are lit again. Is the atelier open tonight?
    nextNodeId: 
    jumps: []
    choices:
    - text: Welcome! We just reopened.
      nextNodeId: welcome
      conditions: []
