  - id: welcome
    speaker: {fileID: 11400000, guid: 997e2aeea31d8f145b61d854dea9ec15, type: 2}
    speakerNameOverride: 
    expression: happy
    text: How wonderful. I'm Luna. I used to come here every full moon.
    nextNodeId: end
    jumps: []
    choices: []
    onEnter: []
  - id: name
    speaker: {fileID: 11400000, guid: 997e2aeea31d8f145b61d854dea9ec15, type: 2}
    speakerNameOverride: 
    expression: neutral
    text: Luna. I used to come here every full moon... I hope that's still allowed.
